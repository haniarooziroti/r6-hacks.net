  "name": "r6-hacks-net",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist"
  },
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://r6-hacks-net.hania-rooziroti.workers.dev"

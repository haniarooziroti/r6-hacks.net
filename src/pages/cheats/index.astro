---
import '../../styles/blog-page.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadBlogPosts } from '../../data/blog/loader';
import { t } from '../../i18n';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BlogFilters from '../../components/blog/BlogFilters.astro';
import { Button } from '@/components/starwind/button';
import { PRODUCT_URL } from '../../config/brand';
import { checkoutPath } from '../../config/checkout';
import { ROUTES } from '../../utils/path';

const seo = resolvePageSeo('/cheats/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Cheat guides', path: '/cheats/' },
];

const allPosts = await loadBlogPosts();
const articleCount = allPosts.length;

/** Hub-only title tweaks to keep "cheats" ≤12 on this page (article H1s unchanged). */
const HUB_TITLE_OVERRIDE: Record<string, string> = {
  'r6-aimbot-setup': 'Aim Circle Size and Smoothing Setup for R6 Siege',
  'r6-cheat-risk': 'Risk and Ban Exposure: An Honest Look at R6 Siege',
  'r6-buy-cheats': 'How to buy R6 Siege access in 2026: checkout to first launch guide',
};

const hubPosts = allPosts.map((post) =>
  HUB_TITLE_OVERRIDE[post.slug] ? { ...post, title: HUB_TITLE_OVERRIDE[post.slug] } : post,
);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({ name: t.blog.title, description: t.blog.subtitle, url: '/cheats/' }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <div class="blog-page">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <header class="blog-page__header">
        <h1 class="blog-page__title">Cheats guides for R6 aimbot, ESP and setup articles</h1>
        <p class="blog-page__intro">{t.blog.subtitle}</p>
      </header>

      <BlogFilters />

      <p class="blog-page__count" data-blog-count aria-live="polite">
        <span data-blog-count-value>{articleCount}</span> {t.blog.articlesCountLabel}
      </p>

      <div id="blog-grid" class="blog-grid" aria-live="polite">
        {hubPosts.map((post, index) => (
          <BlogCard post={post} eager={index === 0} />
        ))}
      </div>

      <p id="blog-empty" class="blog-empty hidden" role="status" data-message={t.blog.emptyFilter}>{t.blog.emptyFilter}</p>

      <aside class="blog-buy-strip" aria-labelledby="blog-buy-title">
        <h2 id="blog-buy-title" class="blog-buy-strip__title">Rainbow Six Siege aimbot, ESP and wallhack</h2>
        <p class="blog-buy-strip__text">
          Compare aim assist, player ESP, gadget markers, and radar modules—then continue to checkout when you are ready.
          Also see the <a href="/faq/">Rainbow Six Siege FAQ</a>, <a href="/reviews/">player reviews</a>, <a href="/about/">about this site</a>, <a href="/go/r6-siege/">checkout overview</a>, <a href="/privacy/">privacy policy</a>, and <a href="/terms/">terms of use</a>.
        </p>
        <div class="blog-buy-strip__actions">
          <Button as="a" href={PRODUCT_URL} variant="primary">Hub strip — R6 module list</Button>
          <Button as="a" href={checkoutPath('r6')} variant="outline">Hub strip — pricing checkout</Button>
          <Button as="a" href={ROUTES.forums} variant="outline">Hub strip — player forums</Button>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
